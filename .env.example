# Optional: enable direct contact-form sending via EmailJS (https://www.emailjs.com)
# 1. Create a free EmailJS account and connect fabiomunez5@gmail.com
# 2. Create an email service + template with variables:
#    from_name, from_email, subject, message
# 3. Copy this file to ".env" and fill in your real keys, then restart `npm run dev`
# Without these, the contact form opens the visitor's mail app instead (nothing is lost).
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
